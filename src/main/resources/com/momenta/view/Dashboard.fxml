<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Arc?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.ArcType?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.momenta.controller.DashboardController">

    <left>
        <VBox fx:id="sidebar" spacing="7" prefWidth="215">
            <children>
                <Label text="MOMENTA" textFill="WHITE" fx:id="sidebarBrand">
                    <font><Font name="System Bold" size="24"/></font>
                </Label>
                <Label text="PERSONAL OPERATING SYSTEM" fx:id="sidebarSub" wrapText="true"/>
                <Separator/>
                <Button id="navOverview" text="◈  Overview" maxWidth="Infinity"/>
                <Button text="✓  Tasks" maxWidth="Infinity" onAction="#onOpenTasks"/>
                <Button text="◎  Goals" maxWidth="Infinity" onAction="#onOpenGoals"/>
                <Button text="▣  Projects" maxWidth="Infinity" onAction="#onOpenProjects"/>
                <Button text="◫  Calendar" maxWidth="Infinity" onAction="#onOpenCalendar"/>
                <Button text="↻  Habits" maxWidth="Infinity" onAction="#onOpenHabits"/>
                <Button text="◒  Finance" maxWidth="Infinity" onAction="#onOpenFinance"/>
                <Button text="◉  Focus" maxWidth="Infinity" onAction="#onOpenFocus"/>
                <Button text="⌁  Analytics" maxWidth="Infinity" onAction="#onOpenAnalytics"/>
                <Separator/>
                <Button text="⚙  Settings" maxWidth="Infinity" onAction="#onOpenSettings"/>
                <Button text="⏻  Logout" maxWidth="Infinity" onAction="#onLogout"/>
            </children>
            <padding><Insets top="20" right="14" bottom="20" left="14"/></padding>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" pannable="true">
            <content>
                <VBox spacing="18" fillWidth="true" id="dashboardContent">
                    <padding><Insets top="24" right="30" bottom="34" left="30"/></padding>

                    <VBox id="dashboardHero" spacing="10" maxWidth="Infinity">
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label id="dashboardKicker" text="MOMENTA • YOUR DAY"/>
                                <Label fx:id="greetingLabel" text="Good afternoon">
                                    <font><Font name="System Bold" size="29"/></font>
                                </Label>
                                <Label fx:id="selectedDateLabel" text="Monday, September 28, 2026"/>
                                <Label id="dashboardSubtitle" text="See what matters now, move the important things forward, and keep your day visible." wrapText="true"/>
                            </VBox>
                            <VBox spacing="8" alignment="CENTER_RIGHT" minWidth="185">
                                <HBox spacing="8" alignment="CENTER_RIGHT">
                                    <Button text="Refresh" onAction="#onRefresh"/>
                                    <Button text="Notifications" onAction="#onOpenNotifications"/>
                                    <Label fx:id="notificationCountLabel" text="0"/>
                                </HBox>
                                <Label id="dashboardStatus" text="LIVE • PERSONALIZED"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <HBox spacing="8" alignment="CENTER" maxWidth="Infinity">
                        <Button text="‹" onAction="#onPreviousDate" minWidth="38"/>
                        <HBox fx:id="dateNavigator" spacing="9" alignment="CENTER" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <!-- Seven date cards are generated by DashboardController. -->
                        </HBox>
                        <Button text="Today" onAction="#onToday" minWidth="58"/>
                        <Button text="›" onAction="#onNextDate" minWidth="38"/>
                    </HBox>

                    <Separator/>

                    <FlowPane id="dashboardFocusRow" hgap="16" vgap="16" prefWrapLength="1040" maxWidth="Infinity">
                        <VBox fx:id="todayProgressCard" minWidth="235" prefWidth="290" maxWidth="360" spacing="8" alignment="CENTER">
                            <padding><Insets top="18" right="16" bottom="18" left="16"/></padding>
                            <Label fx:id="dateProgressTitleLabel" text="TODAY'S PROGRESS">
                                <font><Font name="System Bold" size="13"/></font>
                            </Label>
                            <StackPane fx:id="progressRing" prefWidth="198" prefHeight="198" minWidth="198" minHeight="198" maxWidth="198" maxHeight="198" alignment="CENTER">
                                <children>
                                    <Group>
                                        <Circle fx:id="progressTrack" centerX="0" centerY="0" radius="82"/>
                                        <Arc fx:id="progressArc" centerX="0" centerY="0" radiusX="82" radiusY="82" startAngle="90" length="0" type="OPEN"/>
                                    </Group>
                                    <VBox alignment="CENTER" spacing="1">
                                        <Label fx:id="todayProgressPercentLabel" text="0%">
                                            <font><Font name="System Bold" size="30"/></font>
                                        </Label>
                                        <Label fx:id="todayProgressMetaLabel" text="0 / 0 tasks"/>
                                    </VBox>
                                </children>
                            </StackPane>
                            <Label fx:id="todayProgressHintLabel" text="Complete something important to move your day forward." wrapText="true"/>
                        </VBox>

                        <VBox fx:id="todayTasksCard" spacing="10" minWidth="360" prefWidth="500" maxWidth="620">
                            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="TODAY'S TASKS"><font><Font name="System Bold" size="17"/></font></Label>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="todayTaskSummaryLabel" text=""/>
                            </HBox>
                            <VBox fx:id="todayTaskList" spacing="8"/>
                        </VBox>

                        <VBox fx:id="upcomingCard" spacing="10" minWidth="280" prefWidth="390" maxWidth="500">
                            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="UPCOMING"><font><Font name="System Bold" size="17"/></font></Label>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Calendar" onAction="#onOpenCalendar"/>
                            </HBox>
                            <VBox fx:id="upcomingList" spacing="8"/>
                        </VBox>
                    </FlowPane>

                    <VBox fx:id="nowCard" maxWidth="Infinity" spacing="11">
                        <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label id="nowKicker" text="MOMENTA NOW • NEXT BEST ACTION"/>
                                <Label text="MOMENTA NOW">
                                    <font><Font name="System Bold" size="19"/></font>
                                </Label>
                            </VBox>
                            <Label fx:id="nowPriorityBadge" text="—"/>
                        </HBox>
                        <Label fx:id="nowTitleLabel" text="Loading..." wrapText="true">
                            <font><Font name="System Bold" size="21"/></font>
                        </Label>
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <Label fx:id="nowDeadlineLabel" text=""/>
                            <Label fx:id="nowCategoryLabel" text=""/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <ProgressBar fx:id="nowProgressBar" progress="0" prefHeight="14" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="nowProgressPercentLabel" text="0%" minWidth="42"/>
                        </HBox>
                        <Label fx:id="nowPriorityLabel" text=""/>
                        <Label text="Why this is next" opacity="0.9"><font><Font name="System Bold" size="13"/></font></Label>
                        <Label fx:id="nowReasonsLabel" text="" wrapText="true"/>
                        <Button text="Open Tasks" onAction="#onOpenTasks" maxWidth="170"/>
                    </VBox>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="TODAY'S OVERVIEW">
                            <font><Font name="System Bold" size="16"/></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="overviewDateLabel" text=""/>
                    </HBox>

                    <HBox id="metricStrip" spacing="16" maxWidth="Infinity" alignment="CENTER_LEFT">
                        <VBox fx:id="taskCard"
                              minWidth="0" prefWidth="250" maxWidth="Infinity"
                              minHeight="126" prefHeight="126" maxHeight="126"
                              spacing="8" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #100d1d;
                                     -fx-border-color: #39bdf8;
                                     -fx-border-width: 2;
                                     -fx-border-radius: 20;
                                     -fx-background-radius: 20;
                                     -fx-padding: 18;">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="TASKS"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label id="taskIcon" text="✓"/>
                            </HBox>
                            <Label fx:id="taskCountLabel" text="0">
                                <font><Font name="System Bold" size="27"/></font>
                            </Label>
                            <ProgressBar fx:id="taskProgressBar" progress="0" prefHeight="8" maxWidth="Infinity"/>
                            <Label id="taskMeta" text="completed today" wrapText="true"/>
                        </VBox>

                        <VBox fx:id="goalCard"
                              minWidth="0" prefWidth="250" maxWidth="Infinity"
                              minHeight="126" prefHeight="126" maxHeight="126"
                              spacing="8" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #100d1d;
                                     -fx-border-color: #9270ff;
                                     -fx-border-width: 2;
                                     -fx-border-radius: 20;
                                     -fx-background-radius: 20;
                                     -fx-padding: 18;">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="GOALS"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label id="goalIcon" text="◎"/>
                            </HBox>
                            <Label fx:id="goalCountLabel" text="0">
                                <font><Font name="System Bold" size="27"/></font>
                            </Label>
                            <Label id="goalMeta" text="active goals" wrapText="true"/>
                        </VBox>

                        <VBox fx:id="projectCard"
                              minWidth="0" prefWidth="250" maxWidth="Infinity"
                              minHeight="126" prefHeight="126" maxHeight="126"
                              spacing="8" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #100d1d;
                                     -fx-border-color: #9aa2ff;
                                     -fx-border-width: 2;
                                     -fx-border-radius: 20;
                                     -fx-background-radius: 20;
                                     -fx-padding: 18;">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="PROJECTS"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label id="projectIcon" text="▣"/>
                            </HBox>
                            <Label fx:id="projectCountLabel" text="0">
                                <font><Font name="System Bold" size="27"/></font>
                            </Label>
                            <Label id="projectMeta" text="active projects" wrapText="true"/>
                        </VBox>

                        <VBox fx:id="focusCard"
                              minWidth="0" prefWidth="250" maxWidth="Infinity"
                              minHeight="126" prefHeight="126" maxHeight="126"
                              spacing="8" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #100d1d;
                                     -fx-border-color: #ef76c8;
                                     -fx-border-width: 2;
                                     -fx-border-radius: 20;
                                     -fx-background-radius: 20;
                                     -fx-padding: 18;">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="FOCUS"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label id="focusIcon" text="◉"/>
                            </HBox>
                            <Label fx:id="focusMinutesLabel" text="—">
                                <font><Font name="System Bold" size="27"/></font>
                            </Label>
                            <Label id="focusMeta" text="minutes logged" wrapText="true"/>
                        </VBox>
                    </HBox>

                    <VBox fx:id="gamificationCard" spacing="9" maxWidth="Infinity">
                        <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="MOMENTA LEVEL"><font><Font name="System Bold" size="16"/></font></Label>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="levelLabel" text="LEVEL —"><font><Font name="System Bold" size="18"/></font></Label>
                        </HBox>
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <Label fx:id="xpLabel" text="Loading XP..." wrapText="true" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="streakLabel" text="🔥 0 day streak"/>
                            <Label fx:id="achievementLabel" text="0 / 7 achievements"/>
                        </HBox>
                        <ProgressBar fx:id="xpProgressBar" progress="0" prefHeight="12" maxWidth="Infinity"/>
                    </VBox>

                    <FlowPane id="dashboardSupportGrid" hgap="18" vgap="18" prefWrapLength="1060" maxWidth="Infinity">
                        <VBox id="notificationsCard" spacing="10" minWidth="440" prefWidth="650" maxWidth="760">
                            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="RECENT NOTIFICATIONS"><font><Font name="System Bold" size="16"/></font></Label>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Mark all as read" onAction="#onMarkAllNotificationsRead"/>
                            </HBox>
                            <ListView fx:id="notificationList" maxWidth="Infinity"/>
                        </VBox>

                        <VBox fx:id="insightCard" spacing="8" minWidth="320" prefWidth="480" maxWidth="560">
                            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="DAILY INSIGHT"><font><Font name="System Bold" size="16"/></font></Label>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Refresh" onAction="#onRefreshInsight"/>
                            </HBox>
                            <Label fx:id="insightLabel" text="Loading daily insight..." wrapText="true">
                                <font><Font size="14"/></font>
                            </Label>
                            <Label fx:id="insightAuthorLabel" text="" wrapText="true"/>
                        </VBox>
                    </FlowPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>