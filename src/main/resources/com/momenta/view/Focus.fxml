<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.momenta.controller.FocusController"
            style="-fx-background-color: #0c0915;">

    <top>
        <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-padding: 24 30 18 30; -fx-background-color: #0c0915;">
            <Button text="← Dashboard" onAction="#onBackToDashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: #dedcf5; -fx-border-color: #3b3266; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 8 16; -fx-cursor: hand;"/>
            <VBox spacing="3">
                <Label text="FOCUS MODE" textFill="WHITE">
                    <font><Font name="System Bold" size="24"/></font>
                </Label>
                <Label text="One task. One session. Full attention." textFill="#8f88ab">
                    <font><Font size="13"/></font>
                </Label>
            </VBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background: #0c0915; -fx-background-color: #0c0915; -fx-border-color: transparent;">
            <content>
                <VBox spacing="28" alignment="CENTER" fillWidth="true" style="-fx-padding: 10 30 30 30;">

                    <VBox spacing="4" alignment="CENTER">
                        <Label text="FOCUS SESSION" textFill="#8f88ab">
                            <font><Font name="Segoe UI Semibold" size="12"/></font>
                        </Label>
                        <Label fx:id="sessionTypeLabel" text="DEEP WORK" textFill="#9270ff">
                            <font><Font name="Segoe UI Bold" size="14"/></font>
                        </Label>
                    </VBox>

                    <!-- Timer er duipaser layout: Bam e Task, Majhe Timer, Dane Duration -->
                    <HBox spacing="36" alignment="CENTER" maxWidth="1000">

                        <!-- Bam e: Target Task Card -->
                        <VBox spacing="10" alignment="CENTER_LEFT" prefWidth="250" minWidth="220"
                              style="-fx-background-color: #141026; -fx-background-radius: 18; -fx-border-color: #2b244d; -fx-border-radius: 18; -fx-border-width: 1.5; -fx-padding: 18;">
                            <Label text="TARGET TASK" textFill="#a594fd">
                                <font><Font name="Segoe UI Bold" size="11"/></font>
                            </Label>
                            <ComboBox fx:id="taskComboBox" promptText="Choose a task" maxWidth="Infinity"
                                      style="-fx-background-color: #1c1836; -fx-background-radius: 10; -fx-border-color: #3b3266; -fx-border-radius: 10; -fx-padding: 6 10; -fx-cursor: hand;"/>
                            <Label text="Lock in one task for this sprint" textFill="#736b8e">
                                <font><Font size="11"/></font>
                            </Label>
                        </VBox>

                        <!-- Majhe: Prominent Timer Circle -->
                        <StackPane fx:id="timerCircle" alignment="CENTER" prefWidth="260" prefHeight="260" minWidth="260" minHeight="260">
                            <Circle radius="120" fill="#08060e" stroke="#251f47" strokeWidth="6"/>
                            <VBox alignment="CENTER" spacing="4">
                                <Label fx:id="timerLabel" text="25:00" textFill="WHITE">
                                    <font><Font name="System Bold" size="52"/></font>
                                </Label>
                                <Label text="FOCUS TIME" textFill="#8f88ab">
                                    <font><Font name="Segoe UI Bold" size="11"/></font>
                                </Label>
                            </VBox>
                        </StackPane>

                        <!-- Dane: Duration Minutes Card -->
                        <VBox spacing="10" alignment="CENTER_LEFT" prefWidth="220" minWidth="190"
                              style="-fx-background-color: #141026; -fx-background-radius: 18; -fx-border-color: #2b244d; -fx-border-radius: 18; -fx-border-width: 1.5; -fx-padding: 18;">
                            <Label text="DURATION" textFill="#a594fd">
                                <font><Font name="Segoe UI Bold" size="11"/></font>
                            </Label>
                            <Spinner fx:id="durationSpinner" maxWidth="Infinity" editable="true"
                                     style="-fx-background-color: #1c1836; -fx-background-radius: 10; -fx-border-color: #3b3266; -fx-border-radius: 10; -fx-cursor: hand;"/>
                            <Label text="Recommended: 25 - 50 mins" textFill="#736b8e">
                                <font><Font size="11"/></font>
                            </Label>
                        </VBox>
                    </HBox>

                    <!-- Instruction & Status -->
                    <VBox spacing="6" alignment="CENTER">
                        <Label text="Choose a task and session length above, then start when you're ready." textFill="#8f88ab">
                            <font><Font size="13"/></font>
                        </Label>
                        <Label fx:id="statusLabel" text="Ready" textFill="#a594fd">
                            <font><Font name="Segoe UI Semibold" size="14"/></font>
                        </Label>
                    </VBox>

                    <!-- Controls -->
                    <HBox spacing="12" alignment="CENTER">
                        <Button fx:id="startButton" text="Start" onAction="#onStart" minWidth="100"
                                style="-fx-background-color: #6d4aff; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand;"/>
                        <Button fx:id="pauseButton" text="Pause" onAction="#onPause" minWidth="100"
                                style="-fx-background-color: #1b1733; -fx-text-fill: #dedcf5; -fx-border-color: #3b3266; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10 20; -fx-cursor: hand;"/>
                        <Button fx:id="resumeButton" text="Resume" onAction="#onResume" minWidth="100"
                                style="-fx-background-color: #1b1733; -fx-text-fill: #dedcf5; -fx-border-color: #3b3266; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10 20; -fx-cursor: hand;"/>
                        <Button fx:id="stopButton" text="Stop / Complete" onAction="#onStop" minWidth="140"
                                style="-fx-background-color: #231d42; -fx-text-fill: #ff8fb1; -fx-border-color: #592e54; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10 20; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- Session Stats / History Summary Card -->
                    <VBox spacing="12" maxWidth="800"
                          style="-fx-background-color: #120e24; -fx-background-radius: 16; -fx-border-color: #251f47; -fx-border-radius: 16; -fx-padding: 18;">
                        <Label text="TODAY'S FOCUS SESSIONS" textFill="#a594fd">
                            <font><Font name="Segoe UI Bold" size="12"/></font>
                        </Label>
                        <Label fx:id="historySummaryLabel" text="No focus sessions logged yet today." textFill="#8f88ab" wrapText="true"/>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>