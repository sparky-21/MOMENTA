<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.momenta.controller.FinanceController">

    <top>
        <VBox spacing="10">
            <padding><Insets top="20" right="24" bottom="10" left="24"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="← Dashboard" onAction="#onBackToDashboard"/>
                <Label text="Finance">
                    <font><Font name="System Bold" size="24"/></font>
                </Label>
            </HBox>

            <HBox spacing="30" alignment="CENTER_LEFT">
                <VBox>
                    <Label text="Income"/>
                    <Label fx:id="incomeLabel" text="৳ 0.00"><font><Font name="System Bold" size="16"/></font></Label>
                </VBox>
                <VBox>
                    <Label text="Expenses"/>
                    <Label fx:id="expenseLabel" text="৳ 0.00"><font><Font name="System Bold" size="16"/></font></Label>
                </VBox>
                <VBox>
                    <Label text="Balance"/>
                    <Label fx:id="balanceLabel" text="৳ 0.00"><font><Font name="System Bold" size="16"/></font></Label>
                </VBox>
                <VBox>
                    <Label text="Savings Rate"/>
                    <Label fx:id="savingsLabel" text="0.0%"><font><Font name="System Bold" size="16"/></font></Label>
                </VBox>
            </HBox>

            <HBox spacing="10">
                <Button text="Add Expense" onAction="#onAddExpense"/>
                <Button text="Edit Expense" onAction="#onEditExpense"/>
                <Button text="Delete Expense" onAction="#onDeleteExpense"/>
                <Button text="Add Income" onAction="#onAddIncome"/>
                <Button text="Edit Income" onAction="#onEditIncome"/>
                <Button text="Delete Income" onAction="#onDeleteIncome"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="16">
            <padding><Insets top="6" right="24" bottom="20" left="24"/></padding>

            <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="360">
                <Label text="Expenses">
                    <font><Font name="System Bold" size="14"/></font>
                </Label>
                <TableView fx:id="expenseTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="expenseDateColumn" text="Date" prefWidth="90"/>
                        <TableColumn fx:id="expenseCategoryColumn" text="Category" prefWidth="100"/>
                        <TableColumn fx:id="expenseNoteColumn" text="Note" prefWidth="100"/>
                        <TableColumn fx:id="expenseAmountColumn" text="Amount" prefWidth="80"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="300">
                <Label text="Income">
                    <font><Font name="System Bold" size="14"/></font>
                </Label>
                <TableView fx:id="incomeTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="incomeDateColumn" text="Date" prefWidth="100"/>
                        <TableColumn fx:id="incomeSourceColumn" text="Source" prefWidth="100"/>
                        <TableColumn fx:id="incomeAmountColumn" text="Amount" prefWidth="90"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="8" prefWidth="280">
                <Label text="Spending by Category">
                    <font><Font name="System Bold" size="14"/></font>
                </Label>
                <PieChart fx:id="categoryChart" legendVisible="true" labelsVisible="true" VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
