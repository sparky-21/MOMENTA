<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.momenta.controller.FinanceController">
    <top><VBox id="workspaceHeader" spacing="12" fillWidth="true"><padding><Insets top="20" right="28" bottom="16" left="28"/></padding>
        <HBox spacing="12" alignment="CENTER_LEFT"><Button text="← Dashboard" onAction="#onBackToDashboard"/><VBox spacing="2" HBox.hgrow="ALWAYS"><Label text="FINANCE • MONEY SNAPSHOT"><font><Font name="System Bold" size="28"/></font></Label><Label text="See income, spending, balance and category mix in one place."/></VBox></HBox>
        <FlowPane hgap="14" vgap="14" prefWrapLength="1000" maxWidth="Infinity">
            <VBox id="financeIncomeCard" minWidth="180" prefWidth="230"><Label text="INCOME"/><Label fx:id="incomeLabel" text="৳ 0.00"><font><Font name="System Bold" size="21"/></font></Label><Label id="financeIncomeIcon" text="↗"/></VBox>
            <VBox id="financeExpenseCard" minWidth="180" prefWidth="230"><Label text="EXPENSES"/><Label fx:id="expenseLabel" text="৳ 0.00"><font><Font name="System Bold" size="21"/></font></Label><Label id="financeExpenseIcon" text="↘"/></VBox>
            <VBox id="financeBalanceCard" minWidth="180" prefWidth="230"><Label text="BALANCE"/><Label fx:id="balanceLabel" text="৳ 0.00"><font><Font name="System Bold" size="21"/></font></Label><Label id="financeBalanceIcon" text="◉"/></VBox>
            <VBox id="financeSavingsCard" minWidth="180" prefWidth="230"><Label text="SAVINGS RATE"/><Label fx:id="savingsLabel" text="0.0%"><font><Font name="System Bold" size="21"/></font></Label><Label id="financeSavingsIcon" text="✦"/></VBox>
        </FlowPane>
        <FlowPane id="actionBar" hgap="8" vgap="8" prefWrapLength="900"><Button text="＋ Expense" onAction="#onAddExpense"/><Button text="Edit Expense" onAction="#onEditExpense"/><Button text="Delete Expense" onAction="#onDeleteExpense"/><Button text="＋ Income" onAction="#onAddIncome"/><Button text="Edit Income" onAction="#onEditIncome"/><Button text="Delete Income" onAction="#onDeleteIncome"/></FlowPane>
    </VBox></top>
    <center><ScrollPane id="workspaceBody" fitToWidth="true" pannable="true"><content><VBox spacing="16" fillWidth="true"><padding><Insets top="8" right="28" bottom="24" left="28"/></padding>
        <FlowPane id="financeWorkspaceGrid" hgap="16" vgap="16" prefWrapLength="1050" maxWidth="Infinity">
            <VBox id="expenseTableSurface" spacing="8" minWidth="450" prefWidth="610" minHeight="430"><Label text="EXPENSES"><font><Font name="System Bold" size="16"/></font></Label><Label text="Recent outgoing transactions."/><TableView fx:id="expenseTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="expenseDateColumn" text="Date" prefWidth="95"/><TableColumn fx:id="expenseCategoryColumn" text="Category" prefWidth="120"/><TableColumn fx:id="expenseNoteColumn" text="Note" prefWidth="170"/><TableColumn fx:id="expenseAmountColumn" text="Amount" prefWidth="100"/></columns></TableView></VBox>
            <VBox id="incomeTableSurface" spacing="8" minWidth="330" prefWidth="420" minHeight="430"><Label text="INCOME"><font><Font name="System Bold" size="16"/></font></Label><Label text="Recorded incoming money."/><TableView fx:id="incomeTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="incomeDateColumn" text="Date" prefWidth="110"/><TableColumn fx:id="incomeSourceColumn" text="Source" prefWidth="150"/><TableColumn fx:id="incomeAmountColumn" text="Amount" prefWidth="100"/></columns></TableView></VBox>
            <VBox id="categoryChartSurface" spacing="8" minWidth="360" prefWidth="470" minHeight="430"><Label text="SPENDING BY CATEGORY"><font><Font name="System Bold" size="16"/></font></Label><Label text="A visual breakdown of recorded expenses."/><PieChart fx:id="categoryChart" legendVisible="true" labelsVisible="true" VBox.vgrow="ALWAYS"/></VBox>
        </FlowPane>
    </VBox></content></ScrollPane></center>
</BorderPane>
