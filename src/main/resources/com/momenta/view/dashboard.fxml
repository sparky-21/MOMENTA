<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<!--
    dashboard.fxml — open this file directly in Scene Builder.

    NOTE ON STYLING: there is no linked stylesheet (no fx:stylesheets
    attribute anywhere in this file). Every visual property below is set
    with an inline style="-fx-..." attribute on the element itself — this
    is exactly what Scene Builder's Inspector -> Properties -> Style field
    writes for you if you set colors/fonts/radius from the GUI instead of
    typing FXML by hand. Both approaches produce identical FXML.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.momenta.controller.DashboardController"
            style="-fx-background-color: #0f1115;">

    <!-- ============================ SIDEBAR ============================ -->
    <left>
        <VBox spacing="4" style="-fx-background-color: #14161c; -fx-padding: 20 12 20 12;" prefWidth="220">
            <Label text="MOMENTA" style="-fx-text-fill: #f5f5f7; -fx-font-size: 22px; -fx-font-weight: bold;">
                <VBox.margin>
                    <Insets bottom="4" left="8"/>
                </VBox.margin>
            </Label>
            <Label text="One place to run your life." wrapText="true"
                   style="-fx-text-fill: #7c7f8a; -fx-font-size: 11px;">
                <VBox.margin>
                    <Insets bottom="24" left="8"/>
                </VBox.margin>
            </Label>

            <Button text="⌂  Overview" maxWidth="Infinity"
                    style="-fx-background-color: #23262f; -fx-text-fill: #f5f5f7; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12;"/>
            <Button text="✓  Tasks" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #b6b9c2; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12;"/>
            <Button text="◇  Goals" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #b6b9c2; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12;"/>
            <Button text="▣  Projects" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #b6b9c2; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12;"/>
            <Button text="◷  Calendar" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #b6b9c2; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12;"/>
            <Button text="↻  Habits" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #b6b9c2; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12;"/>
            <Button text="\$ Finance" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #b6b9c2; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12;"/>
            <Button text="◉  Focus" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #b6b9c2; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12;"/>
            <Button text="⌁  Analytics" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #b6b9c2; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator style="-fx-background-color: #23262f;"/>
            <Button text="⚙  Settings" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #b6b9c2; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12;">
                <VBox.margin>
                    <Insets top="8"/>
                </VBox.margin>
            </Button>
        </VBox>
    </left>

    <!-- ============================ MAIN AREA ============================ -->
    <center>
        <VBox spacing="18" style="-fx-padding: 28;">

            <Label text="Tasks" style="-fx-text-fill: #f5f5f7; -fx-font-size: 26px; -fx-font-weight: bold;"/>
            <Label fx:id="taskCountLabel" text="0 task(s) remaining"
                   style="-fx-text-fill: #7c7f8a; -fx-font-size: 13px;"/>

            <!-- Add-task form card -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-background-color: #181a20; -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: #23262f; -fx-border-radius: 12;">
                <TextField fx:id="titleField" promptText="What do you need to do?"
                           style="-fx-background-color: #0f1115; -fx-text-fill: #f5f5f7; -fx-prompt-text-fill: #6a6d78; -fx-background-radius: 8; -fx-padding: 8 10;"
                           HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="categoryBox" style="-fx-background-color: #0f1115; -fx-background-radius: 8;"/>
                <Spinner fx:id="importanceSpinner" editable="true" prefWidth="80"
                         style="-fx-background-color: #0f1115; -fx-background-radius: 8;"/>
                <DatePicker fx:id="deadlinePicker" promptText="Deadline"
                            style="-fx-background-color: #0f1115; -fx-background-radius: 8;"/>
                <Button fx:id="addTaskButton" text="+ Add Task" onAction="#onAddTask"
                        style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 16;"/>
            </HBox>

            <!-- Task table -->
            <TableView fx:id="taskTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #181a20; -fx-background-radius: 12; -fx-border-color: #23262f; -fx-border-radius: 12;">
                <columns>
                    <TableColumn fx:id="titleColumn" text="Task" prefWidth="260"/>
                    <TableColumn fx:id="categoryColumn" text="Category" prefWidth="120"/>
                    <TableColumn fx:id="importanceColumn" text="Importance" prefWidth="100"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="120"/>
                    <TableColumn fx:id="actionColumn" text="Action" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
