<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.momenta.controller.LoginController">
    <center>
        <VBox alignment="CENTER" spacing="15" maxWidth="420">
            <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
            <Label text="MOMENTA"><font><Font name="System Bold" size="34"/></font></Label>
            <Label text="One place to run your life."/>
            <Label fx:id="messageLabel" text="" wrapText="true"/>
            <TextField fx:id="usernameField" promptText="Username"/>
            <PasswordField fx:id="passwordField" promptText="Password"/>
            <Button text="LOGIN" maxWidth="Infinity" onAction="#onLogin"/>
            <Button text="Create an account" maxWidth="Infinity" onAction="#onRegister"/>
        </VBox>
    </center>
</BorderPane>
