<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.momenta.controller.ProjectController">
    <top><VBox id="workspaceHeader" spacing="12" fillWidth="true"><padding><Insets top="20" right="28" bottom="16" left="28"/></padding>
        <HBox spacing="12" alignment="CENTER_LEFT"><Button text="← Dashboard" onAction="#onBackToDashboard"/><VBox spacing="2" HBox.hgrow="ALWAYS"><Label id="moduleKicker" text="PROJECTS • EXECUTION SPACE"/><Label id="pageTitle" text="Projects"><font><Font name="System Bold" size="28"/></font></Label></VBox><Button text="＋ Add Project" onAction="#onAddProject"/></HBox>
        <Label id="pageSubtitle" text="Projects turn goals into execution. Progress is calculated from the work actually linked to each project." wrapText="true" maxWidth="Infinity"/>
        <FlowPane id="actionBar" hgap="8" vgap="8" prefWrapLength="720" maxWidth="Infinity"><Button text="Edit" onAction="#onEditProject"/><Button text="Delete" onAction="#onDeleteProject"/></FlowPane>
    </VBox></top>
    <center><VBox id="workspaceBody" fillWidth="true" spacing="12"><padding><Insets top="8" right="28" bottom="24" left="28"/></padding>
        <VBox id="projectTableSurface" spacing="10" VBox.vgrow="ALWAYS"><HBox spacing="10" alignment="CENTER_LEFT"><Label text="ACTIVE WORK"><font><Font name="System Bold" size="16"/></font></Label><Region HBox.hgrow="ALWAYS"/><Label text="Linked goal • Deadline • Progress"/></HBox>
            <TableView id="workspaceTable" fx:id="projectTable" VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity"><columns>
                <TableColumn fx:id="titleColumn" text="Project" prefWidth="270"/><TableColumn fx:id="goalColumn" text="Linked Goal" prefWidth="180"/><TableColumn fx:id="deadlineColumn" text="Deadline" prefWidth="120"/><TableColumn fx:id="progressColumn" text="Progress" prefWidth="145"/><TableColumn fx:id="statusColumn" text="Status" prefWidth="125"/>
            </columns></TableView></VBox>
    </VBox></center>
</BorderPane>
